# Copie este arquivo para .env.local e preencha com as credenciais do
# seu projeto Supabase (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — nunca expor no cliente. Usada só pelo cron de
# notícias (src/app/api/cron/news) para escrever ignorando RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo que protege /api/cron/news contra chamadas externas.
# Gere um valor aleatório e configure o mesmo valor no header
# Authorization: Bearer <valor> do agendador (Vercel Cron já faz isso
# automaticamente quando este env var está definido no projeto).
CRON_SECRET=
